#!/usr/bin/env bash
# Entry point for the Debian rootfs packaging path.
#
# Prepares a writable data directory, then hands off to the packaged runtime. Kept
# separate from the DroidDeck launcher so the two packaging paths do not share behaviour.
set -euo pipefail

data=${BB_DATA_DIR:-/opt/bbport-data}
mkdir -p "$data"

export BB_DATA_DIR="$data"
export BB_PREBUILT=1
export BB_ANDROID_ROOTFS_PROFILE=${BB_ANDROID_ROOTFS_PROFILE:-1}

if ! /opt/bbport/bin/bbport --vulkan-only >/dev/null 2>&1; then
    cat >&2 <<'EOF'
No usable Vulkan driver found.

This rootfs ships no GPU driver on purpose. Install one with:

    apt-get update && apt-get install -y mesa-vulkan-drivers

or import a Linux/rootfs driver package:

    /opt/bbport/bin/bbport-driver import /path/to/linux-vulkan-driver.zip
EOF
    exit 1
fi

exec /opt/bbport/bin/bbport "$@"